<Project>
  <!-- Global Build Properties for C#/.NET Projects -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="CP.Shared.Primitives.Avails.Extensions" />
  </ItemGroup>

  <!-- Wire CP.Analyzers as an analyzer for all C# projects in Rider / Visual Studio / dotnet build -->
  <ItemGroup Condition="Exists('C:\Users\benho\source\repos\CP.Shared.Primitives\CP.Shared.Primitives\CP.Analyzers\CP.Analyzers.csproj') and '$(MSBuildProjectName)' != 'CP.Analyzers' and '$(MSBuildProjectName)' != 'CP.Analyzers.Tests'">
    <ProjectReference Include="C:\Users\benho\source\repos\CP.Shared.Primitives\CP.Shared.Primitives\CP.Analyzers\CP.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
